<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="DiscImageStudio.DitherTool.DitherWindow"
        Title="黑白抖动" Width="1180" Height="780" MinWidth="900" MinHeight="600"
        WindowStartupLocation="CenterScreen" Background="#F4F5F7" Foreground="#19212C"
        FontSize="14" UseLayoutRounding="True" DragDrop.AllowDrop="True">
    <Window.Resources>
        <ControlTheme x:Key="ToolButton" TargetType="Button">
            <Setter Property="Padding" Value="18,10" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Background" Value="White" />
            <Setter Property="Foreground" Value="#19212C" />
            <Setter Property="BorderBrush" Value="#D8DEE7" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Template">
                <ControlTemplate>
                    <Border Name="Surface" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="7" Padding="{TemplateBinding Padding}">
                        <ContentPresenter Name="PART_ContentPresenter" Content="{TemplateBinding Content}"
                                          HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                </ControlTemplate>
            </Setter>
            <Style Selector="^:pointerover /template/ Border#Surface">
                <Setter Property="Opacity" Value="0.82" />
            </Style>
            <Style Selector="^:disabled /template/ Border#Surface">
                <Setter Property="Opacity" Value="0.4" />
            </Style>
        </ControlTheme>
    </Window.Resources>
    <Window.Styles>
        <Style Selector="Border.panel">
            <Setter Property="Background" Value="White" />
            <Setter Property="BorderBrush" Value="#DEE3EA" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="12" />
        </Style>
        <Style Selector="TextBlock.muted">
            <Setter Property="Foreground" Value="#626D7D" />
        </Style>
    </Window.Styles>
    <Grid Margin="26" RowDefinitions="Auto,Auto,*,Auto">
        <Grid Margin="0,0,0,20" ColumnDefinitions="*,Auto">
            <StackPanel>
                <TextBlock Text="黑白抖动" FontSize="27" FontWeight="SemiBold" />
                <TextBlock Classes="muted" Text="用黑白像素混合保留明暗，保持原图尺寸并导出无损 PNG。" Margin="0,8,0,0" TextWrapping="Wrap" />
            </StackPanel>
            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                <Button x:Name="OpenButton" Theme="{StaticResource ToolButton}" Content="打开图片" Click="Open_Click" />
                <Button x:Name="SaveButton" Theme="{StaticResource ToolButton}" Content="保存黑白 PNG" Click="Save_Click" IsEnabled="False"
                        Background="#245BCC" Foreground="White" BorderBrush="#245BCC" Margin="10,0,0,0" />
            </StackPanel>
        </Grid>
        <Grid Grid.Row="1" Margin="0,0,0,14" RowDefinitions="Auto,Auto,Auto" ColumnDefinitions="*,Auto">
            <StackPanel Grid.ColumnSpan="2" Orientation="Horizontal" Margin="0,0,0,14">
                <TextBlock Text="光盘类型" VerticalAlignment="Center" Margin="0,0,10,0" />
                <ComboBox x:Name="ModePicker" Width="225" SelectedIndex="0" SelectionChanged="Mode_SelectionChanged">
                    <ComboBoxItem Content="DVD 二阶 · 0 / 255" />
                    <ComboBoxItem Content="CD 二阶 · 0 / 255" />
                </ComboBox>
                <TextBlock x:Name="ModeHint" Classes="muted" Text="A5 → 黑色 0 · 92 → 白色 255" FontSize="12" VerticalAlignment="Center" Margin="16,0,0,0" />
            </StackPanel>
            <Grid Grid.Row="1" Grid.ColumnSpan="2" Margin="0,0,0,14" ColumnDefinitions="Auto,*">
                <CheckBox x:Name="GammaToggle" Content="sRGB 伽马校正" IsChecked="False" VerticalAlignment="Center"
                          IsCheckedChanged="Gamma_Changed" />
                <TextBlock Grid.Column="1" x:Name="GammaHint" Classes="muted" Text="已关闭：保持现有明暗分配" FontSize="12"
                           VerticalAlignment="Center" Margin="18,0,0,0" TextWrapping="Wrap" />
            </Grid>
            <TextBlock Grid.Row="2" x:Name="FileText" Classes="muted" Text="打开图片，或将文件拖入窗口" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
            <CheckBox Grid.Row="2" Grid.Column="1" x:Name="ActualSizeToggle" Content="100% 像素查看" Margin="16,0,0,0" VerticalAlignment="Center"
                      IsCheckedChanged="PreviewMode_Changed" />
        </Grid>
        <Grid Grid.Row="2" ColumnDefinitions="*,18,*">
            <Border Classes="panel">
                <Grid RowDefinitions="Auto,*">
                    <StackPanel Margin="18,15">
                        <TextBlock Text="原图" FontWeight="SemiBold" />
                        <TextBlock x:Name="SourceInfo" Classes="muted" Text="保留原始尺寸" FontSize="12" Margin="0,4,0,0" />
                    </StackPanel>
                    <Grid Grid.Row="1" Background="#E9ECF0" Margin="8,0,8,8">
                        <ScrollViewer x:Name="SourceScroll" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto" SizeChanged="Preview_SizeChanged">
                            <Image x:Name="SourceImage" Stretch="Fill" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="10"
                                   RenderOptions.BitmapInterpolationMode="HighQuality" />
                        </ScrollViewer>
                        <TextBlock x:Name="SourcePlaceholder" Text="拖入 PNG / JPG / BMP / TIFF / GIF" Foreground="#738095"
                                   HorizontalAlignment="Center" VerticalAlignment="Center" IsHitTestVisible="False" />
                    </Grid>
                </Grid>
            </Border>
            <Border Grid.Column="2" Classes="panel">
                <Grid RowDefinitions="Auto,*">
                    <StackPanel Margin="18,15">
                        <TextBlock x:Name="ResultHeading" Text="DVD 二阶抖动结果" FontWeight="SemiBold" />
                        <TextBlock x:Name="ResultDetails" Classes="muted" Text="蛇形 Floyd–Steinberg · sRGB 伽马：关 · 无损 PNG" FontSize="12" Margin="0,4,0,0" TextWrapping="Wrap" />
                    </StackPanel>
                    <Grid Grid.Row="1" Background="#E9ECF0" Margin="8,0,8,8">
                        <ScrollViewer x:Name="ResultScroll" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto" SizeChanged="Preview_SizeChanged">
                            <Image x:Name="ResultImage" Stretch="Fill" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="10"
                                   RenderOptions.BitmapInterpolationMode="None" />
                        </ScrollViewer>
                        <TextBlock x:Name="ResultPlaceholder" Text="选择图片后自动处理" Foreground="#738095"
                                   HorizontalAlignment="Center" VerticalAlignment="Center" IsHitTestVisible="False" />
                    </Grid>
                </Grid>
            </Border>
        </Grid>
        <StackPanel Grid.Row="3" Margin="0,17,0,0">
            <Grid ColumnDefinitions="*,Auto">
                <TextBlock Classes="muted" Text="保持原图尺寸 · 透明区域合成白底 · 保存时不覆盖原图" FontSize="12" VerticalAlignment="Center" />
                <StackPanel Grid.Column="1" Orientation="Horizontal">
                    <Border Background="#000000" Width="26" Height="20" CornerRadius="3" />
                    <TextBlock Text="0" Margin="6,0,12,0" />
                    <Border Background="White" BorderBrush="#D8DEE7" BorderThickness="1" Width="26" Height="20" CornerRadius="3" />
                    <TextBlock Text="255" Margin="6,0,0,0" />
                </StackPanel>
            </Grid>
            <ProgressBar x:Name="BusyBar" Height="3" MinHeight="3" Margin="0,12,0,0" IsIndeterminate="True" IsVisible="False" />
            <TextBlock x:Name="StatusText" Classes="muted" Text="就绪" Margin="0,10,0,0" TextTrimming="CharacterEllipsis" />
        </StackPanel>
    </Grid>
</Window>
