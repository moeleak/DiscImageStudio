            <SolidColorBrush x:Key="DangerPressedBrush" Color="#9C0F36" />
            <SolidColorBrush x:Key="WarningBrush" Color="#B45309" />
            <SolidColorBrush x:Key="SuccessBrush" Color="#15803D" />
            <SolidColorBrush x:Key="CloseHotBrush" Color="#C42B1C" />
            <SolidColorBrush x:Key="ScrollbarThumbBrush" Color="#C7C7CC" />
            <SolidColorBrush x:Key="ScrollbarThumbHoverBrush" Color="#A1A1AA" />
            <LinearGradientBrush x:Key="ScrollFadeTopBrush" StartPoint="0%,0%" EndPoint="0%,100%">
                <GradientStop Color="#F5F5F7" Offset="0" />
                <GradientStop Color="#00F5F5F7" Offset="1" />
            </LinearGradientBrush>
            <LinearGradientBrush x:Key="ScrollFadeBottomBrush" StartPoint="0%,0%" EndPoint="0%,100%">
                <GradientStop Color="#00F5F5F7" Offset="0" />
                <GradientStop Color="#F5F5F7" Offset="1" />
            </LinearGradientBrush>
            <SolidColorBrush x:Key="HoverOverlayBrush" Color="#08000000" />
