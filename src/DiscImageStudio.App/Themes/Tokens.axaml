    <Thickness x:Key="TextControlBorderThemeThicknessFocused">1</Thickness>

    <!-- Shape and metric tokens: radii, control heights and the shared page padding. -->
    <CornerRadius x:Key="RadiusField">8</CornerRadius>
    <CornerRadius x:Key="RadiusCard">12</CornerRadius>
    <CornerRadius x:Key="RadiusCardHeader">11,11,0,0</CornerRadius>
    <CornerRadius x:Key="RadiusCardFooter">0,0,11,11</CornerRadius>
    <CornerRadius x:Key="RadiusChip">5</CornerRadius>
    <CornerRadius x:Key="RadiusPanel">8</CornerRadius>
    <CornerRadius x:Key="RadiusFloating">10</CornerRadius>
    <sys:Double x:Key="ButtonHeight">34</sys:Double>
    <sys:Double x:Key="ControlHeight">32</sys:Double>
    <sys:Double x:Key="CompactHeight">28</sys:Double>
    <sys:Double x:Key="SidebarWidth">264</sys:Double>
    <sys:Double x:Key="SidebarCollapsedWidth">60</sys:Double>
    <sys:Double x:Key="SidePanelWidthValue">256</sys:Double>
    <GridLength x:Key="SidePanelWidth">256</GridLength>
    <Thickness x:Key="PagePadding">32,20,32,32</Thickness>

    <!-- Exactly two elevations: FloatingShadow for popups, flyouts and toasts, ModalShadow
         for the confirmation card. -->
    <BoxShadows x:Key="FloatingShadow">0 6 18 0 #73000000</BoxShadows>
    <BoxShadows x:Key="ModalShadow">0 10 32 0 #80000000</BoxShadows>

    <!-- Embedded HarmonyOS Sans SC covers Latin + CJK for the whole UI on every platform. -->
    <FontFamily x:Key="AppFontFamily">avares://DiscImageStudio/Assets/Fonts#HarmonyOS Sans SC</FontFamily>
    <FontFamily x:Key="MonoFontFamily">Cascadia Mono, Consolas, Menlo, DejaVu Sans Mono, avares://DiscImageStudio/Assets/Fonts#HarmonyOS Sans SC</FontFamily>

    <Bitmap x:Key="AppIconSource">avares://DiscImageStudio/Assets/DiscImageStudio-256.png</Bitmap>

    <!-- Window control glyphs (10x10, 1px strokes). -->
    <StreamGeometry x:Key="WinMinimizeIcon">M0,0.5 H10</StreamGeometry>
    <StreamGeometry x:Key="WinMaximizeIcon">M0.5,0.5 H9.5 V9.5 H0.5 Z</StreamGeometry>
    <StreamGeometry x:Key="WinRestoreIcon">M0.5,2.5 H7.5 V9.5 H0.5 Z M2.5,2.5 V0.5 H9.5 V7.5 H7.5</StreamGeometry>
    <StreamGeometry x:Key="WinCloseIcon">M0,0 L10,10 M10,0 L0,10</StreamGeometry>
    <StreamGeometry x:Key="WinEllipsisIcon">M0,1 A1,1 0 1 1 2,1 A1,1 0 1 1 0,1 Z M4,1 A1,1 0 1 1 6,1 A1,1 0 1 1 4,1 Z M8,1 A1,1 0 1 1 10,1 A1,1 0 1 1 8,1 Z</StreamGeometry>
</ResourceDictionary>
