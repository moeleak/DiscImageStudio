<ResourceDictionary xmlns="https://github.com/avaloniaui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:controls="using:DiscImageStudio.Controls">
    <!--
      Keyed control themes. Each key matches the WPF style of the same name, so a view sets
      Theme="{StaticResource PrimaryButton}" where WPF set Style="{StaticResource PrimaryButton}".
      State visuals target template parts: a template-part setter outranks the
      TemplateBinding it replaces, and a derived theme's plain setters cannot mask it.
    -->

    <!-- Text hierarchy: 24 page title, 14 card/panel title, 14 body, 13 field label / hint,
         12 compact, 11 badge. -->
    <ControlTheme x:Key="H1Title" TargetType="TextBlock">
        <Setter Property="FontSize" Value="24" />
        <Setter Property="FontWeight" Value="Bold" />
        <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
    </ControlTheme>
    <ControlTheme x:Key="PageSubtitle" TargetType="TextBlock">
        <Setter Property="FontSize" Value="14" />
        <Setter Property="Foreground" Value="{DynamicResource TextMutedBrush}" />
        <Setter Property="TextWrapping" Value="Wrap" />
    </ControlTheme>
    <ControlTheme x:Key="CardTitle" TargetType="TextBlock">
        <Setter Property="FontSize" Value="14" />
        <Setter Property="FontWeight" Value="Bold" />
        <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
    </ControlTheme>
    <ControlTheme x:Key="PanelTitle" TargetType="TextBlock" BasedOn="{StaticResource CardTitle}" />
    <ControlTheme x:Key="FieldLabel" TargetType="TextBlock">
        <Setter Property="FontSize" Value="13" />
        <Setter Property="Foreground" Value="{DynamicResource TextMutedBrush}" />
        <Setter Property="Margin" Value="0,0,0,6" />
    </ControlTheme>
    <ControlTheme x:Key="RowText" TargetType="TextBlock">
        <Setter Property="FontSize" Value="13" />
        <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
        <Setter Property="TextTrimming" Value="CharacterEllipsis" />
    </ControlTheme>
    <ControlTheme x:Key="BodyText" TargetType="TextBlock">
        <Setter Property="FontSize" Value="14" />
        <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}" />
        <Setter Property="TextWrapping" Value="Wrap" />
        <Setter Property="LineHeight" Value="22" />
    </ControlTheme>
    <ControlTheme x:Key="HintText" TargetType="TextBlock">
        <Setter Property="FontSize" Value="13" />
        <Setter Property="Foreground" Value="{DynamicResource TextMutedBrush}" />
        <Setter Property="TextWrapping" Value="Wrap" />
        <Setter Property="LineHeight" Value="20" />
    </ControlTheme>
    <ControlTheme x:Key="CompactText" TargetType="TextBlock">
        <Setter Property="FontSize" Value="12" />
        <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}" />
        <Setter Property="TextWrapping" Value="Wrap" />
        <Setter Property="LineHeight" Value="18" />
    </ControlTheme>
    <ControlTheme x:Key="CompactHint" TargetType="TextBlock" BasedOn="{StaticResource CompactText}">
        <Setter Property="Foreground" Value="{DynamicResource TextMutedBrush}" />
    </ControlTheme>
    <ControlTheme x:Key="InlineText" TargetType="TextBlock">
        <Setter Property="FontSize" Value="13" />
        <Setter Property="Foreground" Value="{DynamicResource TextMutedBrush}" />
    </ControlTheme>
    <ControlTheme x:Key="MicroText" TargetType="TextBlock">
        <Setter Property="FontSize" Value="11" />
        <Setter Property="Foreground" Value="{DynamicResource TextMutedBrush}" />
    </ControlTheme>
    <ControlTheme x:Key="LegendDot" TargetType="Ellipse">
        <Setter Property="Width" Value="8" />
        <Setter Property="Height" Value="8" />
        <Setter Property="VerticalAlignment" Value="Center" />
    </ControlTheme>
    <ControlTheme x:Key="LegendLabel" TargetType="TextBlock" BasedOn="{StaticResource CompactText}">
        <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
        <Setter Property="VerticalAlignment" Value="Center" />
    </ControlTheme>
    <ControlTheme x:Key="BadgeText" TargetType="TextBlock" BasedOn="{StaticResource MicroText}">
        <Setter Property="FontWeight" Value="Bold" />
        <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}" />
    </ControlTheme>

    <!-- Cards -->
    <ControlTheme x:Key="CardStyle" TargetType="Border">
        <Setter Property="Background" Value="{DynamicResource Surface1Brush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource DividerBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="{StaticResource RadiusCard}" />
        <Setter Property="Padding" Value="16" />
    </ControlTheme>
    <ControlTheme x:Key="CardHeaderBandStyle" TargetType="Border">
        <Setter Property="Background" Value="{DynamicResource Surface2Brush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource DividerBrush}" />
        <Setter Property="BorderThickness" Value="0,0,0,1" />
        <Setter Property="CornerRadius" Value="{StaticResource RadiusCardHeader}" />
        <Setter Property="Padding" Value="0,10" />
    </ControlTheme>
    <ControlTheme x:Key="CardFooterBandStyle" TargetType="Border">
        <Setter Property="Background" Value="{DynamicResource Surface2Brush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource DividerBrush}" />
        <Setter Property="BorderThickness" Value="0,1,0,0" />
        <Setter Property="CornerRadius" Value="{StaticResource RadiusCardFooter}" />
        <Setter Property="Padding" Value="0,8" />
    </ControlTheme>
    <ControlTheme x:Key="DangerCard" TargetType="Border" BasedOn="{StaticResource CardStyle}">
        <Setter Property="Background" Value="{DynamicResource WarningSoftBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource WarningBorderBrush}" />
    </ControlTheme>

    <!-- Buttons. Filled buttons share one shape; each semantic variant owns its color ramp.
         A disabled filled button drops its fill instead of fading. -->
    <ControlTheme x:Key="FilledButtonBase" TargetType="Button">
        <Setter Property="Foreground" Value="White" />
        <Setter Property="Height" Value="{StaticResource ButtonHeight}" />
        <Setter Property="Padding" Value="16,0" />
        <Setter Property="FontSize" Value="14" />
        <Setter Property="FontWeight" Value="Medium" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="CornerRadius" Value="{StaticResource RadiusField}" />
        <Setter Property="HorizontalContentAlignment" Value="Center" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
        <Setter Property="Template">
            <ControlTemplate>
                <ContentPresenter Name="PART_ContentPresenter"
                                  Background="{TemplateBinding Background}"
                                  BorderBrush="{TemplateBinding BorderBrush}"
                                  BorderThickness="{TemplateBinding BorderThickness}"
                                  CornerRadius="{TemplateBinding CornerRadius}"
                                  Padding="{TemplateBinding Padding}"
                                  Foreground="{TemplateBinding Foreground}"
                                  Content="{TemplateBinding Content}"
                                  ContentTemplate="{TemplateBinding ContentTemplate}"
                                  HorizontalContentAlignment="{TemplateBinding HorizontalContentAlignment}"
                                  VerticalContentAlignment="{TemplateBinding VerticalContentAlignment}"
                                  RecognizesAccessKey="True" />
            </ControlTemplate>
        </Setter>
        <Style Selector="^:pointerover /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Opacity" Value="0.9" />
        </Style>
        <Style Selector="^:pressed /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Opacity" Value="0.8" />
        </Style>
        <Style Selector="^:disabled">
            <Setter Property="Cursor" Value="Arrow" />
        </Style>
        <Style Selector="^:disabled /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="{DynamicResource Surface2Brush}" />
            <Setter Property="Foreground" Value="{DynamicResource TextMutedBrush}" />
        </Style>
    </ControlTheme>

    <ControlTheme x:Key="PrimaryButton" TargetType="Button" BasedOn="{StaticResource FilledButtonBase}">
        <Setter Property="Background" Value="{DynamicResource PrimaryBrush}" />
        <Style Selector="^:pointerover /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="{DynamicResource PrimaryHoverBrush}" />
        </Style>
        <Style Selector="^:pressed /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="{DynamicResource PrimaryPressedBrush}" />
        </Style>
        <Style Selector="^:disabled /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="{DynamicResource Surface2Brush}" />
        </Style>
    </ControlTheme>

    <ControlTheme x:Key="DangerButton" TargetType="Button" BasedOn="{StaticResource FilledButtonBase}">
        <Setter Property="Background" Value="{DynamicResource DangerBrush}" />
        <Style Selector="^:pointerover /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="{DynamicResource DangerHoverBrush}" />
        </Style>
        <Style Selector="^:pressed /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="{DynamicResource DangerPressedBrush}" />
        </Style>
        <Style Selector="^:disabled /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="{DynamicResource Surface2Brush}" />
        </Style>
    </ControlTheme>

    <ControlTheme x:Key="SecondaryButton" TargetType="Button" BasedOn="{StaticResource FilledButtonBase}">
        <Setter Property="Background" Value="{DynamicResource Surface2Brush}" />
        <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
        <Setter Property="Padding" Value="14,0" />
        <Style Selector="^:pointerover /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="{DynamicResource Surface3Brush}" />
        </Style>
    </ControlTheme>

    <ControlTheme x:Key="BrowseButton" TargetType="Button" BasedOn="{StaticResource SecondaryButton}">
        <Setter Property="Height" Value="{StaticResource ControlHeight}" />
        <Setter Property="Padding" Value="14,0" />
        <Setter Property="FontSize" Value="13" />
        <Setter Property="Margin" Value="8,0,0,0" />
    </ControlTheme>

    <ControlTheme x:Key="GhostButton" TargetType="Button" BasedOn="{StaticResource SecondaryButton}">
        <Setter Property="Background" Value="Transparent" />
        <Style Selector="^:pointerover /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="{DynamicResource HoverOverlayBrush}" />
        </Style>
        <Style Selector="^:pressed /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="{DynamicResource PressedOverlayBrush}" />
        </Style>
        <Style Selector="^:disabled /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="Transparent" />
        </Style>
    </ControlTheme>

    <ControlTheme x:Key="QuietButton" TargetType="Button" BasedOn="{StaticResource GhostButton}">
        <Setter Property="Foreground" Value="{DynamicResource TextMutedBrush}" />
    </ControlTheme>

    <ControlTheme x:Key="CompactButton" TargetType="Button" BasedOn="{StaticResource SecondaryButton}">
        <Setter Property="Height" Value="{StaticResource CompactHeight}" />
        <Setter Property="Padding" Value="12,0" />
        <Setter Property="FontSize" Value="13" />
        <Setter Property="MinWidth" Value="0" />
    </ControlTheme>

    <ControlTheme x:Key="CompactPrimaryButton" TargetType="Button" BasedOn="{StaticResource PrimaryButton}">
        <Setter Property="Height" Value="{StaticResource CompactHeight}" />
        <Setter Property="Padding" Value="12,0" />
        <Setter Property="FontSize" Value="13" />
        <Setter Property="MinWidth" Value="0" />
    </ControlTheme>

    <ControlTheme x:Key="IconButton" TargetType="Button" BasedOn="{StaticResource GhostButton}">
        <Setter Property="Width" Value="26" />
        <Setter Property="Height" Value="26" />
        <Setter Property="Padding" Value="0" />
        <Setter Property="MinWidth" Value="0" />
        <Setter Property="Focusable" Value="False" />
    </ControlTheme>

    <!-- Start-page tile: no chrome at rest; hover lifts the surface like a sidebar row. -->
    <ControlTheme x:Key="TileButton" TargetType="Button">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="Padding" Value="0" />
        <Setter Property="CornerRadius" Value="{StaticResource RadiusField}" />
        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
        <Setter Property="VerticalContentAlignment" Value="Stretch" />
        <Setter Property="Template">
            <ControlTemplate>
                <ContentPresenter Name="PART_ContentPresenter"
                                  Background="{TemplateBinding Background}"
                                  CornerRadius="{TemplateBinding CornerRadius}"
                                  Padding="{TemplateBinding Padding}"
                                  Content="{TemplateBinding Content}"
                                  ContentTemplate="{TemplateBinding ContentTemplate}"
                                  HorizontalContentAlignment="{TemplateBinding HorizontalContentAlignment}"
                                  VerticalContentAlignment="{TemplateBinding VerticalContentAlignment}" />
            </ControlTemplate>
        </Setter>
        <Style Selector="^:pointerover /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="{DynamicResource Surface2Brush}" />
        </Style>
        <Style Selector="^:pressed /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="{DynamicResource Surface3Brush}" />
        </Style>
        <Style Selector="^:disabled">
            <Setter Property="Opacity" Value="0.4" />
        </Style>
    </ControlTheme>

    <!-- Selectable rows. RowListBoxItem: full-bleed list row with a primary accent bar when
         selected. CardListBoxItem: the inset, rounded dialog variant. -->
    <ControlTheme x:Key="RowListBoxItem" TargetType="ListBoxItem">
        <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
        <Setter Property="FontSize" Value="13" />
        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
        <Setter Property="Padding" Value="0" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="Template">
            <ControlTemplate>
                <Border Name="RowSurface" Background="{TemplateBinding Background}"
                        BorderBrush="{DynamicResource DividerBrush}" BorderThickness="0,0,0,1">
                    <Grid>
                        <Border Name="SelectionBar" Width="2" HorizontalAlignment="Left" Background="Transparent" />
                        <ContentPresenter Name="PART_ContentPresenter" Margin="{TemplateBinding Padding}"
                                          Content="{TemplateBinding Content}"
                                          ContentTemplate="{TemplateBinding ContentTemplate}"
                                          HorizontalContentAlignment="{TemplateBinding HorizontalContentAlignment}"
                                          VerticalContentAlignment="{TemplateBinding VerticalContentAlignment}" />
                    </Grid>
                </Border>
            </ControlTemplate>
        </Setter>
        <Style Selector="^:pointerover /template/ Border#RowSurface">
            <Setter Property="Background" Value="{DynamicResource SurfaceHoverBrush}" />
        </Style>
        <Style Selector="^:selected /template/ Border#RowSurface">
            <Setter Property="Background" Value="{DynamicResource Surface2Brush}" />
        </Style>
        <Style Selector="^:selected /template/ Border#SelectionBar">
            <Setter Property="Background" Value="{DynamicResource PrimaryBrush}" />
        </Style>
        <Style Selector="^:disabled">
            <Setter Property="Opacity" Value="0.4" />
        </Style>
    </ControlTheme>

    <ControlTheme x:Key="CardListBoxItem" TargetType="ListBoxItem">
        <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
        <Setter Property="FontSize" Value="13" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="Template">
            <ControlTemplate>
                <Border Name="CardSurface" Background="{TemplateBinding Background}" CornerRadius="8"
                        Padding="12,8" Margin="0,2">
                    <ContentPresenter Name="PART_ContentPresenter"
                                      Content="{TemplateBinding Content}"
                                      ContentTemplate="{TemplateBinding ContentTemplate}"
                                      HorizontalContentAlignment="{TemplateBinding HorizontalContentAlignment}" />
                </Border>
            </ControlTemplate>
        </Setter>
        <Style Selector="^:pointerover /template/ Border#CardSurface">
            <Setter Property="Background" Value="{DynamicResource HoverOverlayBrush}" />
        </Style>
        <Style Selector="^:selected /template/ Border#CardSurface">
            <Setter Property="Background" Value="{DynamicResource Surface2Brush}" />
        </Style>
        <Style Selector="^:disabled">
            <Setter Property="Opacity" Value="0.4" />
        </Style>
    </ControlTheme>

    <!-- Field variants over the Fluent templates (recolored in Styles.axaml). -->
    <ControlTheme x:Key="CompactTextBox" TargetType="TextBox" BasedOn="{StaticResource {x:Type TextBox}}">
        <Setter Property="Height" Value="{StaticResource CompactHeight}" />
        <Setter Property="MinHeight" Value="{StaticResource CompactHeight}" />
        <Setter Property="FontSize" Value="13" />
        <Setter Property="Padding" Value="6,0" />
    </ControlTheme>
    <!-- Borderless, multi-line log surface. -->
    <ControlTheme x:Key="BareTextBox" TargetType="TextBox" BasedOn="{StaticResource {x:Type TextBox}}">
        <Setter Property="AcceptsReturn" Value="True" />
        <Setter Property="Height" Value="NaN" />
        <Setter Property="MinHeight" Value="0" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="VerticalContentAlignment" Value="Top" />
        <Style Selector="^:pointerover /template/ Border#PART_BorderElement">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
        </Style>
        <Style Selector="^:focus /template/ Border#PART_BorderElement">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
        </Style>
    </ControlTheme>
    <ControlTheme x:Key="CompactComboBox" TargetType="ComboBox" BasedOn="{StaticResource {x:Type ComboBox}}">
        <Setter Property="Height" Value="{StaticResource CompactHeight}" />
        <Setter Property="MinHeight" Value="{StaticResource CompactHeight}" />
        <Setter Property="FontSize" Value="13" />
    </ControlTheme>
    <ControlTheme x:Key="CompactCheckBox" TargetType="CheckBox" BasedOn="{StaticResource {x:Type CheckBox}}">
        <Setter Property="FontSize" Value="13" />
        <Setter Property="MinHeight" Value="24" />
    </ControlTheme>
    <ControlTheme x:Key="CompactProgressBar" TargetType="ProgressBar" BasedOn="{StaticResource {x:Type ProgressBar}}">
        <Setter Property="Height" Value="4" />
        <Setter Property="MinHeight" Value="4" />
    </ControlTheme>
    <ControlTheme x:Key="ToneSlider" TargetType="Slider" BasedOn="{StaticResource {x:Type Slider}}" />
    <ControlTheme x:Key="ToneBipolarSlider" TargetType="Slider" BasedOn="{StaticResource {x:Type Slider}}">
        <!-- No fill: a fill from the left edge would read as "more" for a bipolar value. -->
        <Style Selector="^ /template/ RepeatButton#PART_DecreaseButton">
            <Setter Property="Background" Value="{DynamicResource Surface3Brush}" />
        </Style>
        <Style Selector="^:pointerover /template/ RepeatButton#PART_DecreaseButton">
            <Setter Property="Background" Value="{DynamicResource Surface3Brush}" />
        </Style>
    </ControlTheme>
    <!-- Disclosure header: a flat full-width toggle with a small trailing chevron that turns
         over when open, instead of Fluent's boxed header with a 40 px chevron well. -->
    <ControlTheme x:Key="ExpanderHeaderToggle" TargetType="ToggleButton">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="Template">
            <ControlTemplate>
                <Border Background="{TemplateBinding Background}" CornerRadius="8" Padding="2,6">
                    <Grid ColumnDefinitions="*,Auto">
                        <ContentPresenter Name="PART_ContentPresenter" VerticalAlignment="Center"
                                          Content="{TemplateBinding Content}"
                                          ContentTemplate="{TemplateBinding ContentTemplate}" />
                        <controls:LucideIcon Name="HeaderChevron" Grid.Column="1" Kind="ChevronDown"
                                             Width="16" Height="16" Margin="8,0,0,0" VerticalAlignment="Center"
                                             Foreground="{DynamicResource TextMutedBrush}" />
                    </Grid>
                </Border>
            </ControlTemplate>
        </Setter>
        <Style Selector="^:pointerover">
            <Setter Property="Background" Value="{DynamicResource HoverOverlayBrush}" />
        </Style>
        <Style Selector="^:checked /template/ PathIcon#HeaderChevron">
            <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
            <Setter Property="RenderTransform" Value="rotate(180deg)" />
        </Style>
    </ControlTheme>

    <!-- Every Expander: header toggle over a body that is simply shown or hidden. -->
    <ControlTheme x:Key="{x:Type Expander}" TargetType="Expander">
        <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
        <Setter Property="FontSize" Value="14" />
        <Setter Property="controls:ExpanderAutoScroll.Enabled" Value="True" />
        <Setter Property="Template">
            <ControlTemplate>
                <StackPanel Background="Transparent">
                    <ToggleButton Name="PART_Header" Theme="{StaticResource ExpanderHeaderToggle}"
                                  Focusable="False" Cursor="Hand"
                                  HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch"
                                  Foreground="{TemplateBinding Foreground}"
                                  IsChecked="{TemplateBinding IsExpanded, Mode=TwoWay}"
                                  Content="{TemplateBinding Header}"
                                  ContentTemplate="{TemplateBinding HeaderTemplate}" />
                    <ContentPresenter Name="PART_ContentPresenter" Margin="2,8,2,2"
                                      IsVisible="{TemplateBinding IsExpanded}"
                                      Content="{TemplateBinding Content}"
                                      ContentTemplate="{TemplateBinding ContentTemplate}" />
                </StackPanel>
            </ControlTemplate>
        </Setter>
        <Style Selector="^:disabled">
            <Setter Property="Opacity" Value="0.45" />
        </Style>
    </ControlTheme>

    <!-- Disclosure whose header row is a card title (SectionCard's header chrome); the
         negative margin cancels the header's 2 px inset so titles line up with nearby cards. -->
    <ControlTheme x:Key="CardExpander" TargetType="Expander" BasedOn="{StaticResource {x:Type Expander}}">
        <Setter Property="FontSize" Value="16" />
        <Setter Property="FontWeight" Value="Bold" />
        <Setter Property="Margin" Value="-2,0" />
    </ControlTheme>
</ResourceDictionary>
