<Styles xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!-- Global look that the Fluent palette cannot express. Keep sizes out of here: implicit
         styles outrank control themes, and the Compact* themes own their dimensions. -->
    <Style Selector="Window">
        <Setter Property="Background" Value="{DynamicResource BackgroundBrush}" />
        <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
    </Style>
    <Style Selector="ToolTip">
        <Setter Property="Background" Value="{DynamicResource Surface3Brush}" />
        <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource DividerBrush}" />
        <Setter Property="FontSize" Value="13" />
        <Setter Property="Padding" Value="10,6" />
        <Setter Property="CornerRadius" Value="8" />
    </Style>
    <!-- WPF combo boxes fill their column; Fluent's default is left-aligned and content-sized. -->
    <Style Selector="ComboBox">
        <Setter Property="HorizontalAlignment" Value="Stretch" />
    </Style>
    <Style Selector="CheckBox">
        <Setter Property="CornerRadius" Value="4" />
    </Style>
    <!-- Single-line fields center their text like the WPF fields; multi-line surfaces
         (AcceptsReturn) keep top alignment. -->
    <Style Selector="TextBox[AcceptsReturn=False]">
        <Setter Property="VerticalContentAlignment" Value="Center" />
    </Style>
    <Style Selector="TextBox">
        <Setter Property="SelectionBrush" Value="{DynamicResource PrimaryBrush}" />
        <Setter Property="CaretBrush" Value="{DynamicResource TextPrimaryBrush}" />
    </Style>
</Styles>
