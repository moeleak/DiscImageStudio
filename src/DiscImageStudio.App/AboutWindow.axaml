<Window x:Class="DiscImageStudio.AboutWindow"
        xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:DiscImageStudio.ViewModels"
        x:DataType="vm:AboutViewModel"
        xmlns:controls="using:DiscImageStudio.Controls"
        Title="关于 Disc Image Studio"
        Width="720" SizeToContent="Height"
        MaxHeight="720"
        WindowStartupLocation="CenterOwner"
        CanResize="False"
        Background="{DynamicResource BackgroundBrush}"
        FontFamily="{StaticResource AppFontFamily}"
        UseLayoutRounding="True">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="32" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <controls:TitleBar Grid.Row="0" ProjectTitle="关于"
                           ShowMinimizeButton="False" ShowMaximizeButton="False" />

        <!-- About is a dialog, not a workspace: it has no task of its own and does not belong
             in the navigation the way a work surface does. -->
        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Margin="28,20,28,24">
            <StackPanel>
                <StackPanel Orientation="Horizontal">
                    <Image Source="{StaticResource AppIconSource}" Width="64" Height="64" VerticalAlignment="Center" />
                    <StackPanel Margin="16,0,0,0" VerticalAlignment="Center">
                        <TextBlock Text="Disc Image Studio" Theme="{StaticResource CardTitle}" FontWeight="Medium"
                                   Foreground="{DynamicResource TextPrimaryBrush}" />
                        <TextBlock Text="{Binding VersionText}" Theme="{StaticResource HintText}" Margin="0,6,0,0" />
                    </StackPanel>
                </StackPanel>

                <TextBlock Theme="{StaticResource BodyText}" Margin="0,24,0,0"
                           Text="Disc Image Studio是帮助您在光盘表面印刷图案的一站式工作台。" />
                <TextBlock Theme="{StaticResource CompactHint}" Margin="0,8,0,0" TextWrapping="Wrap"
                           Text="本项目以 GNU General Public License v3.0 or later 发布；重新分发须随附对应源代码并保留第三方声明。" />

                <StackPanel Margin="0,20,0,0">
                    <TextBlock Theme="{StaticResource FieldLabel}" Text="开源组件" />
                    <TextBlock Theme="{StaticResource BodyText}"
                               Text="HarmonyOS Sans SC — HarmonyOS Sans 字体许可协议" />
                    <TextBlock Theme="{StaticResource BodyText}" Margin="0,4,0,0"
                               Text="Avalonia UI — MIT 许可协议" />
                    <TextBlock Theme="{StaticResource BodyText}" Margin="0,4,0,0"
                               Text="SkiaSharp / HarfBuzzSharp — MIT 许可协议" />
                    <TextBlock Theme="{StaticResource BodyText}" Margin="0,4,0,0"
                               Text="BitMiracle.LibTiff.NET — BSD 许可协议" />
                    <TextBlock Theme="{StaticResource BodyText}" Margin="0,4,0,0"
                               Text="Lucide Icons（经 MahApps.Metro.IconPacks 提取）— ISC / MIT 许可协议" />
                    <TextBlock Theme="{StaticResource BodyText}" Margin="0,4,0,0"
                               Text="CommunityToolkit.Mvvm — Apache 许可协议 2.0" />
                </StackPanel>

                <Expander Header="GNU GPL v3.0 或更新版本（项目许可证）" Margin="0,20,0,0">
                    <TextBox Text="{Binding LicenseText, Mode=OneWay}" IsReadOnly="True" Height="240"
                             Margin="0,8,0,0" Theme="{StaticResource BareTextBox}"
                             FontFamily="{StaticResource MonoFontFamily}" FontSize="11"
                             TextWrapping="NoWrap"
                             ScrollViewer.HorizontalScrollBarVisibility="Auto" ScrollViewer.VerticalScrollBarVisibility="Auto" />
                </Expander>
                <Expander Header="第三方声明" Margin="0,8,0,0">
                    <TextBox Text="{Binding ThirdPartyNoticesText, Mode=OneWay}" IsReadOnly="True" Height="240"
                             Margin="0,8,0,0" Theme="{StaticResource BareTextBox}"
                             FontFamily="{StaticResource MonoFontFamily}" FontSize="11"
                             TextWrapping="NoWrap"
                             ScrollViewer.HorizontalScrollBarVisibility="Auto" ScrollViewer.VerticalScrollBarVisibility="Auto" />
                </Expander>
                <Expander Header="HarmonyOS Sans 字体协议" Margin="0,8,0,0">
                    <TextBox Text="{Binding FontLicenseText, Mode=OneWay}" IsReadOnly="True" Height="180"
                             Margin="0,8,0,0" Theme="{StaticResource BareTextBox}"
                             FontFamily="{StaticResource MonoFontFamily}" FontSize="11"
                             TextWrapping="NoWrap"
                             ScrollViewer.HorizontalScrollBarVisibility="Auto" ScrollViewer.VerticalScrollBarVisibility="Auto" />
                </Expander>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</Window>
