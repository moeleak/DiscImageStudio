<Project Sdk="Microsoft.NET.Sdk">
  <!-- Cross-platform (Windows / Linux / macOS) Avalonia shell over DiscImageStudio.Presentation.
       Without arguments it opens the GUI; with arguments it runs the unified command line. -->
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <InvariantGlobalization>false</InvariantGlobalization>
    <AssemblyName>DiscImageStudio</AssemblyName>
    <RootNamespace>DiscImageStudio</RootNamespace>
    <StartupObject>DiscImageStudio.Program</StartupObject>
    <AvaloniaUseCompiledBindingsByDefault>true</AvaloniaUseCompiledBindingsByDefault>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>Assets\DiscImageStudio.ico</ApplicationIcon>
    <Title>Disc Image Studio</Title>
    <Product>Disc Image Studio</Product>
    <Description>Create and stream-burn image-mapped CD, DVD and Blu-ray discs.</Description>
    <Company>Disc Image Studio</Company>
    <Copyright>Copyright © 2026</Copyright>
    <NeutralLanguage>zh-CN</NeutralLanguage>
    <PublishSingleFile>true</PublishSingleFile>
    <!-- Skia and HarfBuzz are native libraries; the single-file bundle extracts them. -->
    <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
    <DebugType>embedded</DebugType>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Avalonia" Version="$(AvaloniaVersion)" />
    <PackageReference Include="Avalonia.Desktop" Version="$(AvaloniaVersion)" />
    <PackageReference Include="Avalonia.Themes.Fluent" Version="$(AvaloniaVersion)" />
    <PackageReference Include="Avalonia.Headless" Version="$(AvaloniaVersion)" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\DiscImageStudio.Presentation\DiscImageStudio.Presentation.csproj" />
  </ItemGroup>
  <ItemGroup>
    <AvaloniaResource Include="Assets\Fonts\HarmonyOS_Sans_SC_Regular.ttf" />
    <AvaloniaResource Include="Assets\Fonts\HarmonyOS_Sans_SC_Medium.ttf" />
    <AvaloniaResource Include="Assets\Fonts\HarmonyOS_Sans_SC_Bold.ttf" />
    <AvaloniaResource Include="Assets\DiscImageStudio-256.png" />
  </ItemGroup>
  <Target Name="ExcludeHostedSolverRuntimeConfiguration" BeforeTargets="_HandleFileConflictsForPublish">
    <!-- The solver runs inside this app and uses its runtime configuration. -->
    <ItemGroup>
      <ResolvedFileToPublish Remove="@(ResolvedFileToPublish)"
          Condition="'%(ResolvedFileToPublish.Filename)%(ResolvedFileToPublish.Extension)' == 'DvdImageSolver.runtimeconfig.json'" />
    </ItemGroup>
  </Target>
</Project>
