<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="using:DiscImageStudio.Controls"
             x:Class="DiscImageStudio.Controls.StageBar">
    <!-- The workflow rail under the page header: design → preview → export → burn, with
         calibration as the branch that feeds back into it. Every stage is clickable. -->
    <UserControl.Styles>
        <Style Selector="Button.Stage">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Padding" Value="8,4" />
            <Setter Property="CornerRadius" Value="{StaticResource RadiusChip}" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Focusable" Value="False" />
            <Setter Property="Template">
                <ControlTemplate>
                    <ContentPresenter Name="PART_ContentPresenter" Background="{TemplateBinding Background}"
                                      CornerRadius="{TemplateBinding CornerRadius}" Padding="{TemplateBinding Padding}"
                                      Content="{TemplateBinding Content}" />
                </ControlTemplate>
            </Setter>
        </Style>
        <Style Selector="Button.Stage:pointerover /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="{DynamicResource HoverOverlayBrush}" />
        </Style>
        <Style Selector="Button.Stage:pressed /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="{DynamicResource PressedOverlayBrush}" />
        </Style>
        <Style Selector="Border.Dot">
            <Setter Property="Background" Value="{DynamicResource Surface2Brush}" />
        </Style>
        <Style Selector="Border.Dot.Current">
            <Setter Property="Background" Value="{DynamicResource PrimaryBrush}" />
        </Style>
        <Style Selector="TextBlock.Index">
            <Setter Property="Foreground" Value="{DynamicResource TextMutedBrush}" />
        </Style>
        <Style Selector="TextBlock.Index.Current">
            <Setter Property="Foreground" Value="White" />
        </Style>
        <Style Selector="TextBlock.Label">
            <Setter Property="Foreground" Value="{DynamicResource TextMutedBrush}" />
        </Style>
        <Style Selector="TextBlock.Label.Current">
            <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
            <Setter Property="FontWeight" Value="Medium" />
        </Style>
    </UserControl.Styles>
    <ItemsControl x:Name="StageList">
        <ItemsControl.ItemsPanel>
            <ItemsPanelTemplate>
                <StackPanel Orientation="Horizontal" />
            </ItemsPanelTemplate>
        </ItemsControl.ItemsPanel>
        <ItemsControl.ItemTemplate>
            <DataTemplate x:DataType="controls:StageItem">
                <StackPanel Orientation="Horizontal">
                    <Rectangle Width="1" Height="14" Fill="{DynamicResource DividerBrush}"
                               Margin="12,0,6,0" VerticalAlignment="Center" IsVisible="{Binding IsBranch}" />
                    <Button Classes="Stage" Click="Stage_Click" Tag="{Binding}">
                        <StackPanel Orientation="Horizontal">
                            <Grid Width="18" Height="18">
                                <Border Classes="Dot" Classes.Current="{Binding IsCurrent}" CornerRadius="9" />
                                <TextBlock Classes="Index" Classes.Current="{Binding IsCurrent}" Text="{Binding IndexText}"
                                           Theme="{StaticResource MicroText}" FontWeight="Bold"
                                           HorizontalAlignment="Center" VerticalAlignment="Center" />
                            </Grid>
                            <TextBlock Classes="Label" Classes.Current="{Binding IsCurrent}" Text="{Binding Label}"
                                       Theme="{StaticResource InlineText}" Margin="7,0,2,0" VerticalAlignment="Center" />
                        </StackPanel>
                    </Button>
                </StackPanel>
            </DataTemplate>
        </ItemsControl.ItemTemplate>
    </ItemsControl>
</UserControl>
