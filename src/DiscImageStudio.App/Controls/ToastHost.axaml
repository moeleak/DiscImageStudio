<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="using:DiscImageStudio.Controls"
             xmlns:vm="using:DiscImageStudio.ViewModels"
             xmlns:conv="using:DiscImageStudio.Hosting"
             x:Class="DiscImageStudio.Controls.ToastHost"
             x:DataType="vm:ShellViewModel">
    <!-- Transient notifications stacked at the top right. Empty host area has no background,
         so clicks pass through to the page underneath. -->
    <UserControl.Styles>
        <Style Selector="Border.ToastCard">
            <!-- Keyframes animate the transform's own X: Avalonia has no animator for a
                 whole RenderTransform value inside a style animation. -->
            <Setter Property="RenderTransform">
                <TranslateTransform />
            </Setter>
            <Style.Animations>
                <Animation Duration="0:0:0.25" FillMode="Forward" Easing="CubicEaseOut">
                    <KeyFrame Cue="0%">
                        <Setter Property="Opacity" Value="0" />
                        <Setter Property="TranslateTransform.X" Value="24" />
                    </KeyFrame>
                    <KeyFrame Cue="100%">
                        <Setter Property="Opacity" Value="1" />
                        <Setter Property="TranslateTransform.X" Value="0" />
                    </KeyFrame>
                </Animation>
            </Style.Animations>
        </Style>
        <Style Selector="Border.KindBar[Tag=Success]">
            <Setter Property="Background" Value="{DynamicResource SuccessBrush}" />
        </Style>
        <Style Selector="Border.KindBar[Tag=Warning]">
            <Setter Property="Background" Value="{DynamicResource WarningBrush}" />
        </Style>
        <Style Selector="Border.KindBar[Tag=Error]">
            <Setter Property="Background" Value="{DynamicResource DangerBrush}" />
        </Style>
        <Style Selector="Border.KindBar[Tag=Info]">
            <Setter Property="Background" Value="{DynamicResource PrimaryBrush}" />
        </Style>
    </UserControl.Styles>
    <ItemsControl x:Name="ToastList" ItemsSource="{Binding Toasts}">
        <ItemsControl.ItemTemplate>
            <DataTemplate x:DataType="vm:ToastItem">
                <Border Classes="ToastCard" Width="320" Margin="0,0,0,10" HorizontalAlignment="Right"
                        Background="{DynamicResource Surface1Brush}" BorderBrush="{DynamicResource DividerBrush}"
                        BorderThickness="1" CornerRadius="{StaticResource RadiusFloating}" Padding="12,10,8,10"
                        BoxShadow="{StaticResource FloatingShadow}"
                        AttachedToVisualTree="ToastCard_Attached">
                    <Grid ColumnDefinitions="Auto,*,Auto">
                        <Border Classes="KindBar" Tag="{Binding Kind, Converter={x:Static conv:ValueConverters.ToStringValue}}"
                                Width="3" CornerRadius="1.5" Margin="0,2,12,2" />
                        <StackPanel Grid.Column="1" Margin="0,0,20,0">
                            <TextBlock Text="{Binding Title}" Theme="{StaticResource PanelTitle}" />
                            <TextBlock Text="{Binding Message}" Theme="{StaticResource CompactText}" Margin="0,4,0,0" />
                        </StackPanel>
                        <Button Grid.Column="2" Theme="{StaticResource IconButton}" VerticalAlignment="Top"
                                ToolTip.Tip="关闭" Click="CloseToast_Click">
                            <controls:LucideIcon Kind="X" Width="14" Height="14" Foreground="{DynamicResource TextMutedBrush}" />
                        </Button>
                    </Grid>
                </Border>
            </DataTemplate>
        </ItemsControl.ItemTemplate>
    </ItemsControl>
</UserControl>
