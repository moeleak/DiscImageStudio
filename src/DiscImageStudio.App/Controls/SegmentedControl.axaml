<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="DiscImageStudio.Controls.SegmentedControl"
             MinWidth="160">
    <!-- Two or three equal cells on a Surface2 track; the brand-filled thumb slides under the
         selected cell. Field height matches the other input controls. -->
    <UserControl.Styles>
        <Style Selector="Button.Segment">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Margin" Value="3" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="HorizontalAlignment" Value="Stretch" />
            <Setter Property="VerticalAlignment" Value="Stretch" />
            <Setter Property="FontSize" Value="14" />
            <Setter Property="FontWeight" Value="Medium" />
            <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}" />
            <Setter Property="Transitions">
                <Transitions>
                    <BrushTransition Property="Foreground" Duration="0:0:0.15" />
                </Transitions>
            </Setter>
            <Setter Property="Template">
                <ControlTemplate>
                    <Border Name="FocusRing" Background="Transparent" CornerRadius="7" BorderThickness="2"
                            BorderBrush="Transparent">
                        <ContentPresenter Content="{TemplateBinding Content}" Foreground="{TemplateBinding Foreground}"
                                          HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                </ControlTemplate>
            </Setter>
        </Style>
        <Style Selector="Button.Segment:pointerover">
            <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
        </Style>
        <Style Selector="Button.Segment.selected">
            <Setter Property="Foreground" Value="{DynamicResource OnPrimaryBrush}" />
        </Style>
        <Style Selector="Button.Segment:focus-visible /template/ Border#FocusRing">
            <Setter Property="BorderBrush" Value="{DynamicResource TextPrimaryBrush}" />
        </Style>
        <Style Selector="Button.Segment:disabled">
            <Setter Property="Opacity" Value="0.45" />
        </Style>
    </UserControl.Styles>
    <Grid Height="{StaticResource ControlHeight}">
        <Border CornerRadius="8" Background="{DynamicResource Surface2Brush}"
                BorderBrush="{DynamicResource DividerBrush}" BorderThickness="1" />
        <Grid x:Name="Cells" Margin="3" ColumnDefinitions="*,*,0">
            <Border x:Name="Thumb" Grid.ColumnSpan="3" HorizontalAlignment="Left" Margin="3" CornerRadius="6"
                    Background="{DynamicResource PrimaryBrush}" BorderBrush="{DynamicResource PrimaryBrush}" BorderThickness="1" />
            <Button x:Name="OptionA" Grid.Column="0" Classes="Segment" Click="OptionClick" KeyDown="OptionKeyDown" />
            <Button x:Name="OptionB" Grid.Column="1" Classes="Segment" Click="OptionClick" KeyDown="OptionKeyDown" />
            <Button x:Name="OptionC" Grid.Column="2" Classes="Segment" Click="OptionClick" KeyDown="OptionKeyDown" IsVisible="False" />
        </Grid>
    </Grid>
</UserControl>
