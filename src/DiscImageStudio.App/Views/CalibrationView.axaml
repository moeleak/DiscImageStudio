<UserControl x:Class="DiscImageStudio.Views.CalibrationView"
             xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:loc="using:DiscImageStudio.Localization"
             xmlns:conv="using:DiscImageStudio.Hosting"
             xmlns:controls="using:DiscImageStudio.Controls"
             xmlns:vm="using:DiscImageStudio.ViewModels"
             x:DataType="vm:CalibrationViewModel"
             SizeChanged="OnViewSizeChanged">
    <!-- Stage + step inspector: the photo canvas is a monitor (toolbar in the header, legend
         above the status footer); the three-step column is a guided disclosure where the
         active step is the expanded one. -->
    <Grid Margin="{StaticResource PagePadding}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>
        <controls:PageHeader Grid.Row="0" Title="{loc:Text Xaml.Calibration2}"
                             Workspace="{x:Static vm:Workspace.Calibration}"
                             Hint="{loc:Text Xaml.UseDiscImageStudioSBuiltInAlgorithmsTo}" />
        <!-- One scroll surface: in the wide layout the work area is exactly the viewport tall
             (the step column is an accordion that never grows past it), in the narrow layout
             it stacks and the page scrolls as one. -->
        <ScrollViewer x:Name="WorkScroll" Grid.Row="1" VerticalScrollBarVisibility="Auto"
                      HorizontalScrollBarVisibility="Disabled" ScrollChanged="OnWorkScrollChanged"
                      SizeChanged="OnWorkspaceSizeChanged" controls:ScrollMaskBehavior.Enabled="True">
            <Grid x:Name="WorkArea">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="16" />
                    <ColumnDefinition Width="{StaticResource SidePanelWidth}" />
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <controls:MonitorCard x:Name="StageCard" Grid.Column="0"
                                      Title="{loc:Text Xaml.CalibrationPhoto}" IconKind="Image"
                                      StatusText="{Binding #PhotoCanvas.SelectionDescription}">
                    <controls:MonitorCard.Actions>
                        <StackPanel Orientation="Horizontal">
                            <Button Theme="{StaticResource IconButton}" Click="OnZoomOut" ToolTip.Tip="{loc:Text Xaml.ZoomOut}"
                                    Margin="0,0,4,0">
                                <controls:LucideIcon Kind="Minus" Width="16" Height="16"
                                                          Foreground="{DynamicResource TextSecondaryBrush}" />
                            </Button>
                            <Button Theme="{StaticResource IconButton}" Click="OnZoomIn" ToolTip.Tip="{loc:Text Xaml.ZoomIn}"
                                    Margin="0,0,8,0">
                                <controls:LucideIcon Kind="Plus" Width="16" Height="16"
                                                          Foreground="{DynamicResource TextSecondaryBrush}" />
                            </Button>
                            <Button Content="{loc:Text Xaml.FitToWindow}" Theme="{StaticResource CompactButton}"
                                    Click="OnResetView" Margin="0,0,8,0" />
                            <TextBlock Text="{Binding #PhotoCanvas.ViewDescription}"
                                       Theme="{StaticResource CompactText}" VerticalAlignment="Center"
                                       MinWidth="42" Margin="0,0,8,0" />
                            <CheckBox Content="{loc:Text Xaml.ShowBurnPattern}" IsChecked="{Binding ShowTargetPreview}"
                                      Theme="{StaticResource CompactCheckBox}" VerticalAlignment="Center"
                                      Margin="0,0,8,0" />
                            <controls:VisibilityGate IsOpen="{Binding IsPhotoStep}">
                                <CheckBox Content="{loc:Text Xaml.ShowRectifiedPreview}" IsChecked="{Binding PreviewRectification, Mode=TwoWay}"
                                          IsEnabled="{Binding IsRectificationReady}"
                                          Theme="{StaticResource CompactCheckBox}" VerticalAlignment="Center"
                                          Margin="0,0,8,0" />
                            </controls:VisibilityGate>
                            <controls:VisibilityGate IsOpen="{Binding IsTraceStep}">
                                <CheckBox Content="{loc:Text Xaml.OverlayFittedCurves}" IsChecked="{Binding ShowPrediction}"
                                          Theme="{StaticResource CompactCheckBox}" VerticalAlignment="Center" />
                            </controls:VisibilityGate>
                        </StackPanel>
                    </controls:MonitorCard.Actions>
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="*" MinHeight="120" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <controls:CalibrationPhotoCanvas x:Name="PhotoCanvas" Grid.Row="0" Margin="1,0"
                            FallbackImage="{Binding TargetImage, Converter={x:Static conv:ValueConverters.RasterImage}}" TargetCanvasRadiusMm="{Binding CanvasOuterRadiusMm}"
                            IsPhotoStep="{Binding IsPhotoStep}" IsRectificationPreview="{Binding PreviewRectification}"
                            IsTargetPreview="{Binding ShowTargetPreview}"
                            CanvasRadiusMm="{Binding PhotoCanvasRadiusMm}"
                            BoundaryPoints="{Binding PhotoBoundaryPoints}" BoundaryContours="{Binding PhotoBoundaryContours}"
                            BoundaryEditedCommand="{Binding BoundaryEditedCommand}"
                            TracePoints="{Binding TracePoints}" TraceEditedCommand="{Binding TraceEditedCommand}"
                            SelectedTraceArm="{Binding SelectedTraceArm}" PredictionContours="{Binding CrossPredictionContours}"
                            OutlierTracePointIndices="{Binding OutlierTracePointIndices}"
                            ShowPrediction="{Binding ShowPrediction}"
                            ToolTip.Tip="{loc:Text Xaml.ScrollToZoomRightDragToPanDragPoints}" />
                        <StackPanel Grid.Row="1" Margin="12,8,12,10">
                            <!-- One legend per step: the colour key lives here and nowhere else,
                                 as swatches instead of colour words. -->
                            <controls:VisibilityGate IsOpen="{Binding IsPhotoStep}">
                                <WrapPanel>
                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,16,0">
                                        <Ellipse Theme="{StaticResource LegendDot}"
                                                 Fill="{DynamicResource CalibrationEdgeBrush}" Margin="0,0,6,0" />
                                        <TextBlock Text="{loc:Text Xaml.PhysicalOuterEdge}" Theme="{StaticResource LegendLabel}" />
                                    </StackPanel>
                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                        <Ellipse Theme="{StaticResource LegendDot}"
                                                 Fill="{DynamicResource CalibrationHubOutlineBrush}" Margin="0,0,6,0" />
                                        <TextBlock Text="{loc:Text Xaml.PhysicalInnerEdge}" Theme="{StaticResource LegendLabel}" />
                                    </StackPanel>
                                </WrapPanel>
                            </controls:VisibilityGate>
                            <controls:VisibilityGate IsOpen="{Binding IsTraceStep}">
                                <WrapPanel>
                                    <Button Content="{loc:Text Xaml.DeletePoint}" Click="OnRemoveTracePoint"
                                            Theme="{StaticResource CompactButton}" Margin="0,0,8,0" />
                                    <Button Content="{loc:Text Xaml.ClearCurves}" Command="{Binding ClearTracesCommand}"
                                            Theme="{StaticResource CompactButton}" Margin="0,0,8,0" />
                                    <TextBlock Text="{Binding TraceSummary}" Theme="{StaticResource CompactText}"
                                               Foreground="{DynamicResource TextPrimaryBrush}"
                                               VerticalAlignment="Center" Margin="0,0,16,0" />
                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,16,0">
                                        <Ellipse Theme="{StaticResource LegendDot}"
                                                 Fill="{DynamicResource CalibrationTraceBrush}" Margin="0,0,6,0" />
                                        <TextBlock Text="{loc:Text Xaml.Photograph}" Theme="{StaticResource LegendLabel}" />
                                    </StackPanel>
                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,16,0">
                                        <Ellipse Theme="{StaticResource LegendDot}"
                                                 Fill="{DynamicResource CalibrationPredictionBrush}" Margin="0,0,6,0" />
                                        <TextBlock Text="{loc:Text Xaml.Prediction}" Theme="{StaticResource LegendLabel}" />
                                    </StackPanel>
                                    <!-- Only appears when the fit marks points whose distance
                                         to the predicted curve exceeds the noise allowance. -->
                                    <controls:VisibilityGate IsOpen="{Binding HasOutlierPoints}"
                                                             VerticalAlignment="Center">
                                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                            <Ellipse Theme="{StaticResource LegendDot}"
                                                     Fill="{DynamicResource DangerBrush}" Margin="0,0,6,0" />
                                            <TextBlock Text="{loc:Text Xaml.LargeDeviation}" Theme="{StaticResource LegendLabel}" />
                                        </StackPanel>
                                    </controls:VisibilityGate>
                                </WrapPanel>
                            </controls:VisibilityGate>
                        </StackPanel>
                    </Grid>
                </controls:MonitorCard>

                <!-- Guided disclosure as an accordion: only one step is expanded and its row
                     is the star, so the expanded card takes exactly the height the two
                     collapsed headers leave over and all three stay on screen. -->
                <Grid x:Name="StepsPanel" Grid.Column="2">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <!-- Stage 1 is the disc itself: without a burned target there is nothing
                         to photograph. It starts expanded and active; installing a target
                         finishes it and hands the column to stage 2. -->
                    <controls:StepCard StepNumber="1" StepTitle="{loc:Text Xaml.CreateCalibrationDisc}" Grid.Row="0" Margin="0,0,0,12"
                                       State="{Binding StepOneState}"
                                       IsExpanded="{Binding StepOneExpanded, Mode=TwoWay}">
                            <StackPanel>
                                <!-- The target follows the project family (no manual disc-type
                                     switch): the line under the button names the parameters a
                                     new target is built from. -->
                                <Button Content="{loc:Text Xaml.CreateTargetFromParameters}" Command="{Binding CreateTargetCommand}"
                                        Theme="{StaticResource CompactPrimaryButton}" HorizontalAlignment="Stretch"
                                        Margin="0,0,0,10" />
                                <TextBlock Text="{Binding CurrentParametersSummary}" Theme="{StaticResource CompactHint}"
                                           Margin="0,0,0,10" />

                                <!-- Two delivery paths, named by what the user does next:
                                     burn here, or take a generated file to another burner. -->
                                <TextBlock Text="{loc:Text Xaml.Burn}" Theme="{StaticResource FieldLabel}" Margin="0,14,0,6" />
                                <Button Content="{loc:Text Xaml.OpenStreamingBurn}" Command="{Binding StreamBurnCommand}"
                                        Theme="{StaticResource CompactButton}" HorizontalAlignment="Left"
                                        ToolTip.Tip="{loc:Text Xaml.OpenBurnToSelectARecorderAndConfirmWriting}" />

                                <TextBlock Text="{loc:Text Xaml.ExternalBurning}" Theme="{StaticResource FieldLabel}" Margin="0,14,0,6" />
                                <TextBlock Text="{loc:Text Xaml.GenerateAnImageOrAudioTrackForExternalBurning}"
                                           Theme="{StaticResource CompactHint}" Margin="0,0,0,8" />
                                <controls:PathField Compact="True" Margin="0,0,0,12"
                                                    Text="{Binding OutputPath}" ButtonLabel="{loc:Text Xaml.ChooseLocation}"
                                                    Command="{Binding BrowseOutputCommand}" />
                                <WrapPanel Margin="0,0,0,12">
                                    <Button Content="{loc:Text Xaml.GenerateImageTrack}" Command="{Binding GenerateImageCommand}"
                                            Theme="{StaticResource CompactButton}" Margin="0,0,8,0" />
                                    <Button Content="{loc:Text Xaml.ExportPatternPNG}" Command="{Binding ExportPngCommand}"
                                            Theme="{StaticResource CompactButton}" />
                                </WrapPanel>

                                <Expander Header="{loc:Text Xaml.CalibrationSessionAdvanced}" IsExpanded="False">
                                    <WrapPanel Margin="0,4,0,0">
                                        <Button Content="{loc:Text Xaml.SaveCalibrationSession}" Command="{Binding SaveSessionCommand}"
                                                Theme="{StaticResource CompactButton}" Margin="0,0,8,0" />
                                        <Button Content="{loc:Text Xaml.OpenCalibrationSession}" Command="{Binding OpenSessionCommand}"
                                                Theme="{StaticResource CompactButton}" />
                                    </WrapPanel>
                                </Expander>
                            </StackPanel>
                        </controls:StepCard>

                        <controls:StepCard StepNumber="2" StepTitle="{loc:Text Xaml.RectifyPhoto}" Grid.Row="1" Margin="0,0,0,12"
                                           State="{Binding StepTwoState}"
                                           IsExpanded="{Binding StepTwoExpanded, Mode=TwoWay}">
                            <StackPanel>
                                <TextBlock Text="{loc:Text Xaml.PhotographBothPhysicalEdgesAndAtLeastOneRadial}"
                                           Theme="{StaticResource CompactHint}" Margin="0,0,0,8" />
                                <Button Content="{loc:Text Xaml.ImportDiscPhoto}" Command="{Binding ImportPhotoCommand}"
                                        Theme="{StaticResource CompactPrimaryButton}" Margin="0,0,0,8"
                                        HorizontalAlignment="Stretch" />
                                <DockPanel Margin="0,0,0,10">
                                    <TextBlock Text="{loc:Text Xaml.DiscSize}" Theme="{StaticResource CompactText}" VerticalAlignment="Center"
                                               DockPanel.Dock="Left" Margin="0,0,10,0" />
                                    <ComboBox Theme="{StaticResource CompactComboBox}"
                                              ItemsSource="{Binding PhysicalDiscSizeChoices}" SelectedItem="{Binding SelectedPhysicalDiscSize, Mode=TwoWay}" DisplayMemberBinding="{ReflectionBinding Label}" />
                                </DockPanel>
                                <Button Content="{loc:Text Xaml.CalculateRectification}" Command="{Binding RectifyPhotoCommand}"
                                        Theme="{StaticResource CompactButton}" HorizontalAlignment="Stretch" Margin="0,0,0,8" />
                                <Button Content="{loc:Text Xaml.ConfirmAndTraceCurves}" Command="{Binding ConfirmRectificationCommand}"
                                        IsEnabled="{Binding IsRectificationReady}"
                                        Theme="{StaticResource CompactPrimaryButton}" HorizontalAlignment="Stretch" />
                                <TextBlock Text="{Binding RectificationSummary}" Theme="{StaticResource CompactHint}" Margin="0,10,0,0" />
                            </StackPanel>
                        </controls:StepCard>

                        <controls:StepCard StepNumber="3" StepTitle="{loc:Text Xaml.TraceAndSolve}" Grid.Row="2"
                                           State="{Binding StepThreeState}"
                                           IsExpanded="{Binding StepThreeExpanded, Mode=TwoWay}">
                            <StackPanel>
                                <TextBlock Text="{loc:Text Xaml.PlacePointsEvenlyAlongAClearCurveFromInside}"
                                           Theme="{StaticResource CompactHint}" Margin="0,0,0,8" />
                                <Button Content="{loc:Text Xaml.BackToPhotoCorrection}" Command="{Binding BackToPhotoCommand}"
                                        Theme="{StaticResource CompactButton}" HorizontalAlignment="Stretch" Margin="0,0,0,10" />
                                <controls:VisibilityGate IsOpen="{Binding IsDvdTarget}">
                                    <StackPanel Margin="0,0,0,10">
                                        <CheckBox IsChecked="{Binding FitDvdPitch, Mode=TwoWay}" Content="{loc:Text Xaml.FitCubicDVDTrackPitch}"
                                                  Theme="{StaticResource CompactCheckBox}" Margin="0,0,0,8" />
                                        <TextBlock Text="{loc:Text Xaml.UseAtLeast16PointsAtDifferentRadiiSpanning}"
                                                   Theme="{StaticResource CompactHint}" />
                                    </StackPanel>
                                </controls:VisibilityGate>
                                <!-- Auto is the useful default; a manual bound is a diagnostic
                                     escape hatch, so it lives folded instead of occupying the
                                     card on every fit. The header still names the current mode. -->
                                <Expander Header="{Binding SearchRangeHeader}" IsExpanded="False"
                                          FontSize="12" Foreground="{DynamicResource TextMutedBrush}"
                                          Margin="0,0,0,10">
                                    <StackPanel>
                                        <ComboBox Theme="{StaticResource CompactComboBox}"
                                                  ItemsSource="{Binding CoarseSearchRangeChoices}"
                                                  SelectedItem="{Binding SelectedCoarseSearchRange, Mode=TwoWay}"
                                                  DisplayMemberBinding="{ReflectionBinding Label}" />
                                    </StackPanel>
                                </Expander>
                                <WrapPanel Margin="0,0,0,10">
                                    <Button Content="{loc:Text Xaml.SolveParameters}" Command="{Binding SolveCommand}"
                                            Theme="{StaticResource CompactPrimaryButton}" Margin="0,0,8,0" />
                                    <Button Content="{loc:Text Xaml.CancelCalculation}" Command="{Binding CancelCommand}"
                                            Theme="{StaticResource CompactButton}" />
                                </WrapPanel>
                                <ComboBox Theme="{StaticResource CompactComboBox}" ItemsSource="{Binding CoarseCandidates}"
                                          SelectedItem="{Binding SelectedCoarseCandidate, Mode=TwoWay}" DisplayMemberBinding="{ReflectionBinding Label}"
                                          MaxDropDownHeight="180" Margin="0,0,0,8" ToolTip.Tip="{loc:Text Xaml.SelectACandidateToSeeItsPredictedCurvesOn}" />
                                <!-- One status line: FitAssessment carries the current verdict;
                                     failures log their details to the log page. -->
                                <TextBlock Text="{Binding FitAssessment}" Theme="{StaticResource CompactHint}" Margin="0,0,0,10" />
                                <CheckBox IsChecked="{Binding ContourConfirmed, Mode=TwoWay}" Theme="{StaticResource CompactCheckBox}" Margin="0,0,0,10">
                                    <TextBlock Text="{loc:Text Xaml.ICheckedTheFullCurveItsShapeAndTurns}" TextWrapping="Wrap" />
                                </CheckBox>
                                <Button Content="{loc:Text Xaml.ApplyCalibration}" Command="{Binding ApplyParametersCommand}"
                                        Theme="{StaticResource CompactPrimaryButton}" HorizontalAlignment="Stretch" />
                            </StackPanel>
                        </controls:StepCard>
                </Grid>
            </Grid>
        </ScrollViewer>
    </Grid>
</UserControl>
