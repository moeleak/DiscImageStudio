<UserControl x:Class="DiscImageStudio.Views.BurnView"
             xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:loc="using:DiscImageStudio.Localization"
             xmlns:controls="using:DiscImageStudio.Controls"
             xmlns:vm="using:DiscImageStudio.ViewModels"
             x:DataType="vm:BurnViewModel">
    <!-- Binds the burn view model directly (State and NavigateCommand are exposed on it),
         like every other workspace page. -->
    <ScrollViewer controls:ScrollMaskBehavior.Enabled="True">
        <StackPanel Margin="{StaticResource PagePadding}">
            <controls:PageHeader Title="{loc:Text Xaml.Burn}" Badge="{Binding FamilyLabel}"
                                 Workspace="{x:Static vm:Workspace.Burn}"
                                 Hint="{loc:Text Xaml.StreamDataDirectlyToABlankDiscWithoutFirst}" />

            <!-- Source: what lands on the disc. The switch is the page's own input selector,
                 the same pattern as the preview workspace's 输入原图/输入镜像; the summary
                 text below follows it. -->
            <controls:SectionCard Header="{loc:Text Xaml.ContentToWrite}" IconKind="Flame" Margin="0,0,0,24">
                <StackPanel>
                    <controls:SegmentedControl HorizontalAlignment="Stretch" Margin="0,0,0,14"
                                               LabelA="{loc:Text Xaml.DesignComposite}" LabelB="{loc:Text Xaml.CalibrationPattern}"
                                               IsSecondSelected="{Binding UseCalibrationPattern}" />
                    <Border Background="{DynamicResource Surface2Brush}" BorderBrush="{DynamicResource DividerBrush}"
                            BorderThickness="1" CornerRadius="{StaticResource RadiusPanel}" Padding="14">
                        <StackPanel>
                            <TextBlock Text="{Binding SourceTitle}" Theme="{StaticResource PanelTitle}" />
                            <TextBlock Text="{Binding SourceDetails}" Theme="{StaticResource HintText}"
                                       Margin="0,6,0,0" />
                        </StackPanel>
                    </Border>
                    <!-- Calibration branch: the pattern is owned by the calibration workspace. -->
                    <controls:VisibilityGate IsOpen="{Binding UseCalibrationPattern}">
                        <Button Theme="{StaticResource CompactButton}" HorizontalAlignment="Left"
                                Margin="0,12,0,0" Content="{loc:Text Xaml.OpenCalibration}"
                                Command="{Binding NavigateCommand}"
                                CommandParameter="{x:Static vm:Workspace.Calibration}" />
                    </controls:VisibilityGate>
                </StackPanel>
            </controls:SectionCard>

            <controls:SectionCard Header="{loc:Text Xaml.RecorderAndSpeed}" IconKind="Info" Margin="0,0,0,24"
                                  IsEnabled="{Binding IsSetupEnabled}">
                <StackPanel>
                    <TextBlock Theme="{StaticResource FieldLabel}" Text="{loc:Text Xaml.Recorder}" />
                    <Grid Margin="0,0,0,12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <ComboBox ItemsSource="{Binding Devices}"
                                  SelectedItem="{Binding SelectedDevice}"
                                  DisplayMemberBinding="{ReflectionBinding DisplayName}" />
                        <Button Grid.Column="1" Theme="{StaticResource SecondaryButton}" Margin="8,0,0,0"
                                Command="{Binding RefreshDevicesCommand}">
                            <StackPanel Orientation="Horizontal">
                                <controls:LucideIcon Kind="RotateCw" Width="14" Height="14"
                                                          VerticalAlignment="Center" />
                                <TextBlock Text="{loc:Text Xaml.Refresh}" Margin="7,0,0,0" VerticalAlignment="Center" />
                            </StackPanel>
                        </Button>
                    </Grid>
                    <TextBlock Text="{Binding DeviceStatusText}" Theme="{StaticResource HintText}" />
                    <TextBlock Theme="{StaticResource FieldLabel}" Text="{loc:Text Xaml.WriteSpeed}" Margin="0,16,0,6" />
                    <Grid Margin="0,0,0,8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <ComboBox ItemsSource="{Binding Speeds}"
                                  SelectedItem="{Binding SelectedSpeed}"
                                  DisplayMemberBinding="{ReflectionBinding DisplayName}"
                                  IsEnabled="{Binding IsSpeedComboEnabled}" />
                        <Button Grid.Column="1" Theme="{StaticResource SecondaryButton}" Margin="8,0,0,0"
                                IsEnabled="{Binding IsSpeedRefreshEnabled}"
                                Command="{Binding RefreshSpeedsCommand}">
                            <StackPanel Orientation="Horizontal">
                                <controls:LucideIcon Kind="Disc" Width="14" Height="14"
                                                          VerticalAlignment="Center" />
                                <TextBlock Text="{loc:Text Xaml.ReadDisc}" Margin="7,0,0,0" VerticalAlignment="Center" />
                            </StackPanel>
                        </Button>
                    </Grid>
                    <TextBlock Text="{Binding SpeedStatusText}" Theme="{StaticResource HintText}" />
                </StackPanel>
            </controls:SectionCard>

            <!-- Danger zone: the warning, its acknowledgement and the single action that
                 starts the write belong to one card. Progress is reported by the job dock. -->
            <Border Theme="{StaticResource DangerCard}">
                <StackPanel>
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                        <controls:LucideIcon Kind="TriangleAlert" Width="24" Height="24"
                                                  Foreground="{DynamicResource WarningBrush}" />
                        <TextBlock Text="{loc:Text Xaml.BeforeBurning}" Theme="{StaticResource CardTitle}" Margin="10,0,0,0"
                                   VerticalAlignment="Center" />
                    </StackPanel>
                    <TextBlock Theme="{StaticResource BodyText}" Foreground="{DynamicResource WarningTextBrush}"
                               Text="{loc:Text Xaml.StreamingRequiresBlankMediaInterruptionsPowerLossOrInsufficient}" />
                    <CheckBox Content="{loc:Text Xaml.IHaveInsertedTheCorrectBlankDisc}"
                              IsChecked="{Binding ConfirmChecked}" Margin="0,14,0,0"
                              IsEnabled="{Binding IsSetupEnabled}" />
                    <StackPanel Orientation="Horizontal" Margin="0,16,0,0">
                        <Button Theme="{StaticResource DangerButton}" Content="{loc:Text Xaml.StartStreamingBurn}"
                                Command="{Binding StartBurnCommand}" Margin="0,0,10,0" />
                        <Button Theme="{StaticResource SecondaryButton}" Content="{loc:Text Xaml.CancelBurn}"
                                Command="{Binding CancelBurnCommand}" />
                    </StackPanel>
                    <TextBlock Text="{Binding BurnStatusText}" Theme="{StaticResource CompactHint}"
                               Margin="0,12,0,0" />
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</UserControl>
